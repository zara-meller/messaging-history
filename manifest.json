{
  "manifest_version": 3,
  "name": "Messaging History",
  "version": "0.2.1",
  "description": "One click on a competitor's homepage shows how their headline and positioning changed over the last two years.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Show messaging history",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://web.archive.org/*"]
}
